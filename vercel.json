{
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/logos/:path(.*)\\.mp4",
      "destination": "https://www.google.com/logos/:path.mp4",
      "permanent": false
    },
    {
      "source": "/logos/:path(.*)\\.mp3",
      "destination": "https://www.google.com/logos/:path.mp3",
      "permanent": false
    },
    {
      "source": "/logos/:path(.*)\\.ogg",
      "destination": "https://www.google.com/logos/:path.ogg",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/m/:sha/:path*", "destination": "https://cdn.jsdelivr.net/gh/NV4s/swfdump@:sha/:path*" },
    { "source": "/mr/:sha/:path*", "destination": "https://raw.githubusercontent.com/NV4s/swfdump/:sha/:path*" },
    { "source": "/ml/:sha/:path*", "destination": "https://media.githubusercontent.com/media/NV4s/swfdump/:sha/:path*" },
    { "source": "/e/:version/:path*", "destination": "https://cdn.jsdelivr.net/npm/@emulatorjs/emulatorjs@:version/data/:path*" },

    { "source": "/p/36d84be5/run-3.swf", "destination": "https://player03.com/run/3/Run3.swf" },
    { "source": "/p/0756f330", "destination": "https://landgreen.github.io/n-gon/" },
