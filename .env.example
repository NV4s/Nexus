# Only VITE_* variables reach the browser. Vite inlines them into the public
# bundle at build time, so anything secret must NOT carry that prefix — this repo
# is public, and a VITE_ADMIN_PASSWORD would compile, deploy and publish the
# password with no error anywhere.

# URL of your deployed EaglercraftX client (see deploy/eaglercraft-relay/README.md).
# This is the client, not the relay. Leave unset and the Eaglercraft card is not shown.
# Baked in at build time: setting it in Vercel does nothing until the next deploy.
VITE_EAGLERCRAFT_URL=

# ---------------------------------------------------------------------------
# Server-only. Set these in the Vercel dashboard (Settings > Environment
# Variables), never in a committed file. Listed here for documentation only.
# ---------------------------------------------------------------------------

# Password for /#/admin. Longer is the single biggest security win available here.
# ADMIN_PASSWORD=

# Signs the admin session cookie: openssl rand -base64 32
# Rotating this immediately invalidates every existing admin session.
# ADMIN_SESSION_SECRET=

# Upstash Redis, from the Upstash console. Without these the site still works —
# tracking simply records nothing and the admin panel shows zeroes.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
